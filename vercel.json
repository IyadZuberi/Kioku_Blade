{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm -C game build",
  "outputDirectory": "game/dist",
  "headers": [
    { "source": "/assets/:file([^/]+\\.(?:js|css))", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/:dir(ph|chars)/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/mediapipe/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/models/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
