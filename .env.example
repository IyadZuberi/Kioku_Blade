# Mubit (server-side only). Copy this file to .env and put your key there. Do NOT commit .env
# Your Mubit key (console: Connect > Mubit key). Starts with mbt_.
MUBIT_API_KEY=
# The plan model: Mubit's starter-credit gpt-6-luna on its OpenAI route (no provider key, no daily token cap).
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
MUBIT_MODEL=gpt-6-luna
# Backup when that refuses a call: Groq's gpt-oss-120b through Mubit (needs a Groq key under Provider keys: OpenAI-compatible).
MUBIT_BACKUP_MODEL=openai/gpt-oss-120b
MUBIT_BACKUP_BASE=https://api.mubit.ai/compat/groq/v1
PORT=8787

HOST_TOKEN=            # secret for the host-only rule override (H key); unset = override disabled
