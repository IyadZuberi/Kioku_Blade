# Mubit (server-side only). Copy this file to .env and put your key there. Do NOT commit .env
# Your Mubit key (console: Connect > Mubit key). Starts with mbt_.
MUBIT_API_KEY=
# Mubit forwards to your Groq key (console: Provider keys > OpenAI-compatible > Groq).
MUBIT_BASE_URL=https://api.mubit.ai/compat/groq/v1
MUBIT_MODEL=openai/gpt-oss-120b
PORT=8787

HOST_TOKEN=            # secret for the host-only rule override (H key); unset = override disabled
